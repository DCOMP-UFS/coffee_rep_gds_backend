# MongoDB local (Docker)
MONGO_PORT=27018
MONGO_ROOT_USER=gds
MONGO_ROOT_PASSWORD=gds
MONGO_DB=coffee_gds_db

MONGO_URI=mongodb://gds:gds@localhost:27018/coffee_gds_db?authSource=admin

# mongo-express (http://localhost:8081)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# Migração do dump do Postgres (GCP)
DUMP_PATH=../db-backup/gestao-salas-dump.sql

# API
PORT=8080

# Origens permitidas no CORS, separadas por vírgula. Em produção, a URL do frontend.
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# Par RSA para assinar os JWTs. Gere o seu com `pnpm keys:generate` e cole aqui.
# O `\n` escapado é proposital: é o formato aceito por .env e pela Vercel.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Validade do token em segundos (86400 = 24h)
EXPIRATION_TIME=86400

# Admin criado por `pnpm seed:admin`
ADMIN_CPF=17055661030
ADMIN_PASSWORD=1234
