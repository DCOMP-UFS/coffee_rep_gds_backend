# Ambiente do cluster no MongoDB Atlas.
#
# Copie para `.env.atlas` e preencha. Use com a opção --env nos scripts de CLI:
#   pnpm db:migrate --env .env.atlas --yes
#   pnpm seed:admin --env .env.atlas
#
# O arquivo que o Atlas gera no onboarding usa MONGODB_URI; aqui a variável se chama
# MONGO_URI, e a URI precisa do nome do banco antes da query string.
#
# Se a senha tiver caracteres especiais (@ : / ? # [ ] %), ela precisa ser percent-encoded
# dentro da URI: @ vira %40, # vira %23, / vira %2F, e assim por diante.
MONGO_URI="mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/coffee_gds_db?retryWrites=true&w=majority"
MONGO_DB=coffee_gds_db

# Caminho do dump do Postgres, relativo à raiz deste projeto.
DUMP_PATH=../db-backup/gestao-salas-dump.sql

# Par RSA dos JWTs. Gere com: pnpm keys:generate --write --env .env.atlas
# Não reutilize as chaves do ambiente local.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

EXPIRATION_TIME=86400

# Origem do frontend em produção.
CORS_ORIGINS=http://localhost:4200

# Admin inicial. O dump já traz um admin, então o seed costuma ser um no-op.
ADMIN_CPF=17055661030
ADMIN_PASSWORD=troque-esta-senha
